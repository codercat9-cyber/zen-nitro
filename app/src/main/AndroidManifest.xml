<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Самообновление: скачанный APK отдаётся штатному установщику системы.
         Ставит его человек вручную, своим нажатием — тихой установки тут нет
         и быть не может, для неё нужны права владельца устройства. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Видимость чужих пакетов.
         Начиная с Android 11 приложение по умолчанию НЕ видит, что ещё стоит на
         телефоне: getInstalledApplications возвращает огрызок из нескольких
         системных. Для выбора «что пустить мимо туннеля» это смертельно — на
         телефоне 51 российское приложение, а список показывал Google Play и
         Mi Браузер.
         Просим ровно то, что нужно: приложения, у которых есть значок запуска.
         Это у́же, чем QUERY_ALL_PACKAGES, и покрывает всё, что человек вообще
         может захотеть увести мимо туннеля. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZenBlaster">

        <!-- singleTask: возврат из шторки/недавних должен поднимать УЖЕ открытое
             окно. Без этого система создавала второй экземпляр активити, тот
             стартовал с нуля и показывал «Подключиться», хотя туннель работал. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Ссылки Amnezia (vpn://…) — открываем прямо в приложении. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vpn" />
            </intent-filter>

            <!-- ФИЛЬТРА НА ФАЙЛЫ ЗДЕСЬ БОЛЬШЕ НЕТ — И НЕ ВОЗВРАЩАТЬ.
                 Раньше стоял VIEW с android:mimeType="*/*" и pathPattern на
                 .conf. Для content://-ссылок путь обычно не содержит имени
                 файла, поэтому pathPattern не отсекал ничего, и приложение
                 объявлялось обработчиком ЛЮБОГО файла: при открытии apk
                 система предлагала «ZEN DPI BLASTER» рядом с установщиком
                 пакетов. Конфиги импортируются в самом приложении —
                 полем ввода, кнопкой «из буфера» и «Поделиться» ниже. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Долгое нажатие на плитку в шторке. Без этого фильтра Android
                 не знает, что открывать, и уводит в системные «О приложении».
                 С ним — открывается сам клиент. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- VPN-служба. BIND_VPN_SERVICE обязателен для VpnService. -->
        <service
            android:name=".vpn.ZenVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="systemExempted">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Ядро Amnezia (AWG 1.5/2.0) в своём процессе: libwg.so и libbox.so
             оба несут рантайм Go, а два рантайма в одном процессе дерутся за
             обработчики сигналов. Android всё равно держит один активный VPN,
             так что разделение ничего не стоит. -->
        <!-- DPI-щит в своём процессе: его падения (а это чужой C-код, и он
             падает) больше не уносят с собой приложение и туннель. -->
        <service
            android:name=".vpn.DpiService"
            android:exported="false"
            android:process=":dpi" />

        <service
            android:name=".vpn.ZenAwgService"
            android:exported="false"
            android:process=":awg"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="systemExempted">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Запасное ядро AmneziaWG старой ветки (AWG 1.x). Своё ядро на Go —
             значит, свой процесс: два рантайма Go в одном не уживаются. -->
        <service
            android:name=".vpn.ZenAwgLegacyService"
            android:exported="false"
            android:process=":awg1"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="systemExempted">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Плитка быстрых настроек: включение туннеля прямо из шторки. -->
        <service
            android:name=".vpn.ZenTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- Через него установщик системы читает скачанный APK. Начиная с
             Android 7 передать file:// нельзя — прилетает FileUriExposedException.
             Область видимости задана в res/xml/file_paths.xml: только update/. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
