<?xml version="1.0" encoding="utf-8"?>
<!--
  Отдаём наружу РОВНО два каталога во внешних файлах приложения:

    update/ — скачанный APK, его читает установщик системы;
    report/ — отчёт чёрного ящика, который человек сам отправляет на разбор.

  Оба каталога мы наполняем сами и знаем, что в них лежит. Ни настройки, ни
  подписки, ни конфиги через провайдер не видны — корень внешних файлов
  наружу не открыт намеренно, там лежит и сам журнал с историей подключений.
-->
<paths>
    <external-files-path name="zen_update" path="update/" />
    <external-files-path name="zen_report" path="report/" />
</paths>
